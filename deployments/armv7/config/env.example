# =============================================================================
#  板端推荐配置（Zynq-7020 / Cortex-A9 @666MHz / 1GB RAM）
#
#  install.sh 会把它复制成 /opt/pyflask/app/.env
#  改完记得： /etc/init.d/pyflask restart
# =============================================================================

APP_ENV=production

# ---- 服务 ----
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
DEBUG=false
THREAD_NUM=4

# ---- 安全（务必修改）----
# 生成方法：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-PLEASE
CORS_ORIGINS=*

# ---- 认证 ----
AUTH_ENABLED=true
# memory：用户存进程内存，重启即丢（够用就先用这个）
# sqlalchemy：持久化到数据库，需要配 SQLALCHEMY_URI 并迁移建表
AUTH_STORE=memory
AUTH_TOKEN_TTL=2592000
# 关键性能参数：默认 600000 在 A9 上要 3.1 秒/次
#   150000 → 约 0.8 秒（推荐）
#    50000 → 约 0.26 秒（内网可接受）
AUTH_PBKDF2_ITERATIONS=150000
AUTH_LOGIN_MAX_FAILS=5

# ---- 可选组件（板子上建议全关）----
SOCKETIO_ENABLED=false
TCP_ENABLED=false
UDP_ENABLED=false
TASK_WORKER_EMBEDDED=false

# ---- 监控 ----
METRICS_ENABLED=true

# ---- 数据库（默认不用；要持久化时打开）----
# SQLALCHEMY_URI=sqlite:////opt/pyflask/app/storage/app.db
# AUTH_STORE=sqlalchemy
