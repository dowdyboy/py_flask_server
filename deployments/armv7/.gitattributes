# 部署包里有二进制文件，diff 没意义，标记为 binary
*.tar.gz binary
*.whl     binary

# 部署包整体作为类二进制资产处理（可选：如果你的仓库用 LFS）
# runtime/*.tar.gz filter=lfs diff=lfs merge=lfs -text

# shell 脚本必须保持 LF：Windows 上 core.autocrlf=true 会把工作区副本转成 CRLF，
# 直接打包/拷贝到 ARM 设备后 shebang（#!/bin/sh）失效，报 "bad interpreter"。
*.sh       text eol=lf
pyflask    text eol=lf
