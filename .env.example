# 环境配置（APP_ENV 提供预设档，以下变量可单独覆盖）
APP_ENV=development

# 服务配置
SERVER_PORT=5000
SERVER_HOST=127.0.0.1
DEBUG=true
THREAD_NUM=10

# SocketIO（默认关闭；启用需安装 Flask-SocketIO + simple-websocket）
SOCKETIO_ENABLED=false
SOCKETIO_ASYNC_MODE=threading

# CORS 允许来源: * 或逗号分隔列表
CORS_ORIGINS=*

# API 文档
API_TITLE=Flask Server API
API_VERSION=v1
SWAGGER_UI_URL=https://cdn.jsdelivr.net/npm/swagger-ui-dist/

# 安全配置
SECRET_KEY=flask-server-scaffold-default-key-change-in-production
MAX_CONTENT_LENGTH=16777216

# 日志配置
LOG_FORMAT=text
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_TO_CONSOLE=

# 数据库（默认不启用，按需配置其一）
SQLALCHEMY_URI=
SQLITE_DB_PATH=
DB_REFLECT_ON_START=true
DB_POOL_SIZE=10
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
DB_POOL_TIMEOUT=30
INIT_SQL_PATH=

# Redis 缓存（默认不启用，未配置时使用内存缓存）
REDIS_URL=

# Flask-Migrate
FLASK_APP=flask_server.app:app
