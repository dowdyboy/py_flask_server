# 环境配置（APP_ENV 提供预设档，以下变量可单独覆盖）
APP_ENV=development

# 服务配置
SERVER_PORT=5000
SERVER_HOST=127.0.0.1
DEBUG=true
THREAD_NUM=10
# gunicorn worker 数（仅 wsgi_gunicorn.py 生效）
WORKER_NUM=4

# SocketIO（默认关闭；启用需安装 Flask-SocketIO + simple-websocket）
SOCKETIO_ENABLED=false
SOCKETIO_ASYNC_MODE=threading
# WebSocket 单条消息大小上限（字节，默认 1MB）
SOCKETIO_MAX_HTTP_BUFFER_SIZE=1000000

# TCP 协议服务器（默认关闭；启用后 flask_server/handler/ 下的处理器自动生效）
TCP_ENABLED=false
TCP_HOST=0.0.0.0
TCP_PORT=9000
# 消息定界（四种模式）：
#   line（默认）    按分隔符切分，分隔符可配 TCP_FRAME_SEPARATOR（支持转义，如 \r\n）
#   fixed           按固定长度切分（TCP_FRAME_LENGTH 字节）
#   head_tail       按帧头帧尾定界（TCP_FRAME_HEAD / TCP_FRAME_TAIL，支持二进制转义如 \xaa\x55）
#   raw             原始 recv 流，由处理器自行处理粘包/拆包
TCP_FRAMING=line
TCP_FRAME_SEPARATOR=\n
TCP_FRAME_LENGTH=1024
TCP_FRAME_HEAD=
TCP_FRAME_TAIL=
# 单条消息上限（字节，超限视为协议错误断开连接，防内存 DoS）
TCP_MAX_MESSAGE_LENGTH=65536
# 并发连接上限（每连接一线程，超限拒绝新连接，防线程耗尽 DoS；≤0 表示不限制）
TCP_MAX_CONNECTIONS=256
# 空闲连接超时（秒）：连接在此期间无数据到达即关闭，防"只连不发"占满并发槽位；≤0 表示不设超时
TCP_IDLE_TIMEOUT=300

# UDP 协议服务器（默认关闭；处理器返回 bytes 自动回发到来源地址）
UDP_ENABLED=false
UDP_HOST=0.0.0.0
UDP_PORT=9001
# 单数据报大小上限（字节；注意：超过此大小的数据报会被操作系统静默截断）
UDP_MAX_MESSAGE_LENGTH=65536
# 并发处理数据报上限（每数据报一线程，超限丢弃数据报，防洪泛线程爆炸 DoS；≤0 表示不限制）
UDP_MAX_CONCURRENCY=256

# CORS 允许来源: * 或逗号分隔列表
CORS_ORIGINS=*

# API 文档
API_TITLE=Flask Server API
API_VERSION=v1
SWAGGER_UI_URL=https://cdn.jsdelivr.net/npm/swagger-ui-dist/

# 安全配置
SECRET_KEY=flask-server-scaffold-default-key-change-in-production
MAX_CONTENT_LENGTH=16777216
# HSTS：置于 HTTPS 反向代理之后时建议开启（HTTP 明文下浏览器会忽略该头，默认关闭）
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000

# 日志配置
LOG_FORMAT=text
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_TO_CONSOLE=
# 日志文件路径：未设置（本行保持注释）或设为空字符串时仅控制台日志（不写文件，容器/Docker logs 场景推荐）。
# 设为非空路径则写文件（如项目根 server.log，按 LOG_MAX_BYTES 轮转）。
# 测试场景建议保持注释/置空，避免测试运行污染日志。
# LOG_FILE_PATH=
# 开发调试：打印 SQL 语句
DEBUG_SQL=false

# 数据库（默认不启用，按需配置其一）
SQLALCHEMY_URI=
SQLITE_DB_PATH=
DB_REFLECT_ON_START=true
DB_POOL_SIZE=10
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
DB_POOL_TIMEOUT=30
INIT_SQL_PATH=

# Redis 缓存（默认不启用，未配置时使用内存缓存）
REDIS_URL=

# 限流（默认关闭）
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_STORE=memory

# 可信代理（get_real_ip 仅信任这些来源的 X-Forwarded-For；支持精确 IP 与 CIDR，如 172.16.0.0/12 覆盖 Docker 网关网段）
TRUSTED_PROXIES=127.0.0.1,::1

# 安全响应头
SECURITY_HEADERS_ENABLED=true

# 异步任务队列上限
ASYNC_TASK_QUEUE_MAX=500

# 认证模块（默认关闭；AUTH_STORE=sqlalchemy 需配置 SQLALCHEMY_URI 并迁移建表）
AUTH_ENABLED=false
AUTH_TOKEN_TTL=604800
AUTH_REFRESH_TOKEN_TTL=2592000
AUTH_STORE=memory
# 登录防爆破：同一 (用户名, 来源 IP) 连续失败 N 次锁定 M 秒
AUTH_LOGIN_MAX_FAILS=5
AUTH_LOGIN_LOCK_SECONDS=300
# 密码哈希 PBKDF2-HMAC-SHA256 迭代次数（仅影响新写入的哈希；哈希串自带迭代次数，可平滑升级）
AUTH_PBKDF2_ITERATIONS=600000

# 雪花 ID 机器标识（0-31；多副本部署务必显式配置不同值）
# 未配置时按 (crc32(hostname) + pid) % 32 派生：容器内 hostname 可区分副本，但仍非严格保证；
# 对唯一性零容忍的场景请改用 KeyGenerator.generate_uuid7()（时间有序 UUID，无需分配机器号）
SNOWFLAKE_WORKER_ID=
# 雪花 ID 数据中心标识（0-31；多机房/多集群各配不同值）
SNOWFLAKE_DATACENTER_ID=1

# 任务队列（Redis Streams；未配置 REDIS_URL 时退化为进程内内存队列，仅单进程可用）
TASK_QUEUE_STREAM=tasks:default
TASK_QUEUE_GROUP=default
# worker 并发消费线程数
TASK_WORKER_CONCURRENCY=4
# 最大重试次数（0=失败直接进死信）与退避基数（秒，第 n 次重试延迟 = backoff * 2**(n-1)）
TASK_MAX_RETRIES=3
TASK_RETRY_BACKOFF=5
# 可见性超时（秒）：worker 崩溃后 pending 消息超过该时长会被重新投递（交付语义 at-least-once）
TASK_VISIBILITY_TIMEOUT=300
# 任务状态保留时长（秒，Redis 后端用作 key TTL）与死信队列上限
TASK_STATUS_TTL=86400
TASK_DEAD_LETTER_MAX=1000
# 单次出队阻塞时长（秒）
TASK_RESERVE_TIMEOUT=2
# 是否在 Web 进程内嵌 worker（开发便利；生产请独立跑 scripts/worker.py）
TASK_WORKER_EMBEDDED=false

# Prometheus 指标（/metrics，依赖 prometheus-client，缺失时自动降级）
METRICS_ENABLED=true
# gunicorn 多 worker 时必须设置（指向一个目录），否则 /metrics 只能看到被刮到的那个 worker 的数据
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus-multiproc

# Flask-Migrate
FLASK_APP=flask_server.app:app
