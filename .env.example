# 环境配置（APP_ENV 提供预设档，以下变量可单独覆盖）
APP_ENV=development

# 服务配置
SERVER_PORT=5000
SERVER_HOST=127.0.0.1
DEBUG=true
THREAD_NUM=10
# gunicorn worker 数（仅 wsgi_gunicorn.py 生效）
WORKER_NUM=4

# SocketIO（默认关闭；启用需安装 Flask-SocketIO + simple-websocket）
SOCKETIO_ENABLED=false
SOCKETIO_ASYNC_MODE=threading
# WebSocket 单条消息大小上限（字节，默认 1MB）
SOCKETIO_MAX_HTTP_BUFFER_SIZE=1000000

# CORS 允许来源: * 或逗号分隔列表
CORS_ORIGINS=*

# API 文档
API_TITLE=Flask Server API
API_VERSION=v1
SWAGGER_UI_URL=https://cdn.jsdelivr.net/npm/swagger-ui-dist/

# 安全配置
SECRET_KEY=flask-server-scaffold-default-key-change-in-production
MAX_CONTENT_LENGTH=16777216

# 日志配置
LOG_FORMAT=text
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_TO_CONSOLE=
# 日志文件路径（默认项目根 server.log）；设为空字符串则禁用文件日志（仅控制台）。
# 测试场景建议设置为空：LOG_FILE_PATH=
# LOG_FILE_PATH=
# 开发调试：打印 SQL 语句
DEBUG_SQL=false

# 数据库（默认不启用，按需配置其一）
SQLALCHEMY_URI=
SQLITE_DB_PATH=
DB_REFLECT_ON_START=true
DB_POOL_SIZE=10
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
DB_POOL_TIMEOUT=30
INIT_SQL_PATH=

# Redis 缓存（默认不启用，未配置时使用内存缓存）
REDIS_URL=

# 限流（默认关闭）
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_STORE=memory

# 可信代理（get_real_ip 仅信任这些来源的 X-Forwarded-For；支持精确 IP 与 CIDR，如 172.16.0.0/12 覆盖 Docker 网关网段）
TRUSTED_PROXIES=127.0.0.1,::1

# 安全响应头
SECURITY_HEADERS_ENABLED=true

# 异步任务队列上限
ASYNC_TASK_QUEUE_MAX=500

# 认证模块（默认关闭；AUTH_STORE=sqlalchemy 需配置 SQLALCHEMY_URI 并迁移建表）
AUTH_ENABLED=false
AUTH_TOKEN_TTL=604800
AUTH_REFRESH_TOKEN_TTL=2592000
AUTH_STORE=memory
# 登录防爆破：连续失败 N 次锁定 M 秒
AUTH_LOGIN_MAX_FAILS=5
AUTH_LOGIN_LOCK_SECONDS=300

# 雪花 ID 机器标识（0-31；多进程部署建议显式配置，未配置时按 PID 自动派生）
SNOWFLAKE_WORKER_ID=

# Prometheus 指标（/metrics，依赖 prometheus-client，缺失时自动降级）
METRICS_ENABLED=true

# Flask-Migrate
FLASK_APP=flask_server.app:app
